{"name":"AutoLoop","short_name":"AutoLoop","description":"AutoLoop runs the software lifecycle end to end. Telemetry becomes tickets, cloud agents implement them, and code reaches production only when CI and release gates agree.","start_url":"/autoloop/","display":"standalone","background_color":"#04060a","theme_color":"#04060a","icons":[{"src":"/autoloop/icon.svg","sizes":"any","type":"image/svg+xml"}]}